# Copy to .env.test and use a different password. Disposable local/CI database.
NODE_ENV=test
API_PORT=3001
DB_ENV=test
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ai_job_hunter_test
DB_USER=ai_job_hunter_test
DB_PASSWORD=replace-with-a-unique-test-password

# Internal AI provider; startup and unit tests do not contact Ollama.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
AI_REQUEST_TIMEOUT_MS=120000
