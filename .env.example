# Copy to .env and replace the password. Local development only.
NODE_ENV=development
API_PORT=3000
DB_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ai_job_hunter_dev
DB_USER=ai_job_hunter_dev
DB_PASSWORD=replace-with-a-unique-development-password

# Internal AI provider; startup and unit tests do not contact Ollama.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
AI_REQUEST_TIMEOUT_MS=120000
