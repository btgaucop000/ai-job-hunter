{
  "name": "@ai-job-hunter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node --env-file-if-exists=../../.env --enable-source-maps dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:compile": "node ../../scripts/clean-test-output.mjs && tsc -p tsconfig.test.json",
    "test": "pnpm test:compile && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js --runInBand",
    "test:integration": "pnpm test:compile && node --env-file-if-exists=../../.env.test --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.js --runInBand",
    "smoke:ollama": "pnpm test:compile && node .test-dist/test/manual/ollama.smoke.js",
    "smoke:extraction": "pnpm test:compile && node .test-dist/test/manual/extraction.smoke.js"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/typeorm": "12.0.2",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "8.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "12.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "@types/yauzl": "3.4.0",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "tsc-watch": "7.2.1"
  }
}
